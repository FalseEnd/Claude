<?xml version="1.0" encoding="utf-8"?>
<!-- Supabase 一律走 https，只信任系統內建的憑證（不信任使用者自己裝的憑證）。
     開發時連本機 Supabase 用的 http 例外只放在 debug 版（src/debug/res/xml/），正式版完全不能用 http。 -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
