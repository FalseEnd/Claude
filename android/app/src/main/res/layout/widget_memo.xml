<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小工具「備忘錄」：放在桌面的備忘錄（一則一張便利貼，由程式依大小加進 memo_list） -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/memo_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <TextView
            android:id="@+id/memo_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:fontFamily="@font/huninn"
            android:maxLines="1"
            android:text="📝 備忘錄"
            android:textColor="@color/widget_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/memo_header_more"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/huninn"
            android:maxLines="1"
            android:textColor="@color/widget_muted"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- 便利貼由上往下排（一般大小） -->
    <LinearLayout
        android:id="@+id/memo_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone" />

    <!-- 又寬又矮（橫的桌面、4×1）：便利貼並排 -->
    <LinearLayout
        android:id="@+id/memo_row"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/memo_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_memo_hint"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp">

        <TextView
            android:id="@+id/memo_empty_emoji"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📌"
            android:textColor="@color/widget_text"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/memo_empty_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/huninn"
            android:gravity="center"
            android:maxLines="3"
            android:text="在備忘錄裡打開『放在桌面』"
            android:textColor="@color/widget_muted"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
