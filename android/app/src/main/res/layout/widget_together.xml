<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小工具「在一起」：兩個人的頭像和在一起的天數 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="10dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/me_avatar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_avatar_me" />

        <TextView
            android:id="@+id/heart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="4dp"
            android:text="💗"
            android:textSize="18sp" />

        <ImageView
            android:id="@+id/partner_avatar"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_avatar_partner" />
    </LinearLayout>

    <TextView
        android:id="@+id/together_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="@font/huninn"
        android:text="在一起"
        android:textColor="@color/widget_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/together_days"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/huninn"
            android:includeFontPadding="false"
            android:text="520"
            android:textColor="@color/widget_accent"
            android:textSize="30sp" />

        <TextView
            android:id="@+id/together_unit"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:fontFamily="@font/huninn"
            android:includeFontPadding="false"
            android:paddingBottom="3dp"
            android:text="天"
            android:textColor="@color/widget_accent"
            android:textSize="14sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/together_sub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:ellipsize="end"
        android:fontFamily="@font/huninn"
        android:gravity="center"
        android:maxLines="1"
        android:text="阿哲 ♥ 小雨"
        android:textColor="@color/widget_muted"
        android:textSize="11sp" />
</LinearLayout>
