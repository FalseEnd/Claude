<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小工具「在一起」（一格高）：我的頭像 ♥ 對方頭像｜在一起 N 天＋一行小字。拉高時整列置中，頭像跟著變大 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="5dp">

    <!-- 頭像跟著小工具的高度變大，最大多大在程式裡依寬度決定 -->
    <LinearLayout
        android:id="@+id/couple"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/me_avatar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:maxWidth="30dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_avatar_me" />

        <!-- 疊在兩個頭像中間：白色小圓底、實心愛心 -->
        <ImageView
            android:id="@+id/heart"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="-5dp"
            android:layout_marginEnd="-5dp"
            android:background="@drawable/widget_heart_bg"
            android:contentDescription="@null"
            android:padding="2dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_heart"
            android:translationZ="2dp" />

        <ImageView
            android:id="@+id/partner_avatar"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:maxWidth="30dp"
            android:scaleType="fitCenter"
            android:src="@drawable/widget_avatar_partner" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <!-- 放得下才顯示（桌面上挑小工具時的預覽用這個版面的預設值，要放得進 2×1） -->
            <TextView
                android:id="@+id/together_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="4dp"
                android:fontFamily="@font/huninn"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="在一起"
                android:textColor="@color/widget_muted"
                android:textSize="12sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/together_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/huninn"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="514"
                android:textColor="@color/widget_accent"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/together_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="3dp"
                android:fontFamily="@font/huninn"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="天"
                android:textColor="@color/widget_accent"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/together_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:fontFamily="@font/huninn"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="阿哲 · 小雨"
            android:textColor="@color/widget_muted"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
