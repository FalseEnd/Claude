<?xml version="1.0" encoding="utf-8"?>
<!-- 桌面小工具「對方狀態」（一格高）：頭像｜名字＋一行狀態（📍 在哪 · 🔋 電量 · 心情…）｜🤗 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="5dp"
    android:paddingEnd="3dp"
    android:paddingBottom="5dp">

    <!-- 頭像的高度跟著小工具的高度，最大 maxWidth -->
    <ImageView
        android:id="@+id/partner_avatar"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:adjustViewBounds="true"
        android:contentDescription="@null"
        android:maxWidth="40dp"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_avatar_partner" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <!-- 名字太長時先縮名字，更新時間留著 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:baselineAligned="true"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/partner_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/huninn"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="小雨"
                android:textColor="@color/widget_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/huninn"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="14:05"
                android:textColor="@color/widget_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:ellipsize="end"
            android:fontFamily="@font/huninn"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:text="📍 公司 · 🔋 85% · 😊 開心"
            android:textColor="@color/widget_text"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- 看起來是 38dp 的圓，可以按的範圍是 48dp 寬、整個高度 -->
    <TextView
        android:id="@+id/hug_button"
        android:layout_width="48dp"
        android:layout_height="match_parent"
        android:layout_marginStart="3dp"
        android:background="@drawable/widget_hug"
        android:contentDescription="抱抱"
        android:gravity="center"
        android:includeFontPadding="false"
        android:text="🤗"
        android:textSize="18sp" />
</LinearLayout>
